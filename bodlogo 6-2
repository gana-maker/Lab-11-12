      "source": [
        "data = \"\"\"Уламбаяр Төртогтох эрэгтэй МБУС МЗТ 99044079\n",
        "Баттогтох Цэен-Ойдов эрэгтэй МБУС МЗТ 99003771\n",
        "Сандагдорж Балдорж эрэгтэй МБУС МТ 88859959\n",
        "Уртнасан Гантогтох эмэгтэй МБУС МЗТ 88081699\n",
        "Алимаа Бор эмэгтэй НХУС ТТ 88169994\n",
        "Тунгалаг Балжир эмэгтэй НХУС АХТ 80159991\"\"\"\n",
        "\n",
        "with open(\"input.txt\", \"w\", encoding=\"utf-8\") as f:\n",
        "    f.write(data)\n",
        "\n",
        "operators = {\n",
        "    \"Мобиком\": [\"99\", \"95\", \"94\", \"85\"],\n",
        "    \"Скайтел\": [\"90\", \"91\", \"96\"],\n",
        "    \"Юнител\": [\"80\", \"86\", \"88\", \"89\"],\n",
        "    \"Жимобайл\": [\"93\", \"97\", \"98\"]\n",
        "}\n",
        "\n",
        "counts = {name: 0 for name in operators}\n",
        "\n",
        "with open(\"input.txt\", encoding=\"utf-8\") as f:\n",
        "    for line in f:\n",
        "        info = line.split()\n",
        "        if len(info) != 6:\n",
        "            continue\n",
        "\n",
        "        prefix = info[5][:2]\n",
        "\n",
        "        for name, prefixes in operators.items():\n",
        "            if prefix in prefixes:\n",
        "                counts[name] += 1\n",
        "                break\n",
        "\n",
        "winner = max(counts, key=counts.get)\n",
        "\n",
        "with open(\"output.txt\", \"w\", encoding=\"utf-8\") as f:\n",
        "    f.write(f\"{winner} {counts[winner]}\\n\")\n",
        "\n",
        "print(winner, counts[winner])"
